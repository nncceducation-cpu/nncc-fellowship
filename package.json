{
  "name": "nncc-portal-app",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor native wrapper for the Harvey Sarnat NNCC Fellowship member portal.",
  "scripts": {
    "build:web": "node tools/build-www.mjs",
    "sync": "npm run build:web && npx cap sync",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#0c2a4d' --splashBackgroundColor '#0c2a4d'",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
